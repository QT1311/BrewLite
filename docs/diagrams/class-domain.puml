@startuml ClassDomain
title Class-01 — Domain model BrewLite
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
hide empty methods

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  EWALLET
  CARD
}
enum PaymentStatus {
  SUCCEEDED
  FAILED
}
enum DiscountType {
  PERCENT
  FIXED
}
enum SizeCode {
  S
  M
  L
}

class User {
  +id: int <<PK>>
  +email: string <<unique>>
  +name: string
  -passwordHash: string
  +role: customer | staff | admin
  +isActive: boolean
  +loyaltyPoints: int
  +createdAt: timestamp
}
class Product {
  +id: int <<PK>>
  +name: string
  +description: string
  +price: int  «giá thấp nhất»
  +sizePrices: Map<SizeCode,int> [0..1]
  +allowToppings: boolean
  +imageUrl: string
  +category: string
  +stock: int
  +version: int  «optimistic lock»
}
class Order {
  +id: int <<PK>>
  +status: OrderStatus
  +total: int  «sau giảm giá»
  +discountAmount: int
  +promotionCode: string [0..1]  «snapshot»
  +pointsRedeemed: int
  +pointsDiscount: int  «1 điểm = 100đ»
  +createdAt: timestamp
  +updatedAt: timestamp
}
class OrderItem {
  +id: int <<PK>>
  +productId: int
  +name: string  «snapshot»
  +size: SizeCode [0..1]
  +toppings: string[]
  +unitPrice: int  «snapshot»
  +quantity: int [1..20]
}
class Payment {
  +id: int <<PK>>
  +idempotencyKey: string <<unique>>
  +method: PaymentMethod
  +amount: int
  +status: PaymentStatus
  +transactionRef: string [0..1]
  +failureReason: string [0..1]
  +createdAt: timestamp
}
class Promotion {
  +id: int <<PK>>
  +code: string <<unique>>
  +description: string
  +discountType: DiscountType
  +value: int
  +minOrderTotal: int
  +maxDiscount: int [0..1]
  +maxUses: int [0..1]
  +usedCount: int
  +expiresAt: timestamp [0..1]
  +isActive: boolean
}
class LoyaltyTransaction {
  +id: int <<PK>>
  +type: EARN | REDEEM | REFUND
  +points: int  «âm khi dùng điểm»
  +createdAt: timestamp  «EARN: unique(orderId)»
}

User "1" -- "0..*" Order : đặt >
User "1" -- "0..*" Payment : thực hiện >
Order "1" *-- "1..*" OrderItem : gồm
Order "1" -- "0..*" Payment : được thanh toán bởi >
OrderItem "0..*" ..> "1" Product : tham chiếu (productId)
Order "0..*" -- "0..1" Promotion : áp dụng >
User "1" -- "0..*" LoyaltyTransaction : tích điểm
LoyaltyTransaction "0..*" -- "1" Order : phát sinh từ >

Order ..> OrderStatus
Promotion ..> DiscountType
Payment ..> PaymentMethod
Payment ..> PaymentStatus
OrderItem ..> SizeCode

note bottom of Order
  Chuyển trạng thái hợp lệ:
  PENDING → PAID | PAYMENT_FAILED | CANCELLED
  PAYMENT_FAILED → PAID | CANCELLED
  PAID → PREPARING → READY → COMPLETED
end note
@enduml
