# Sao chép file này thành .env rồi điền giá trị thật (KHÔNG commit file .env)
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_dev_password
POSTGRES_DB=brewlite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production (Railway...): đặt DATABASE_URL, khi đó POSTGRES_* bị bỏ qua. DB_SSL=true nếu nhà cung cấp yêu cầu.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=false
# Migration tự chạy khi API khởi động (đặt false để tắt). synchronize mặc định tắt (chỉ bật khi thử nghiệm cục bộ).
# DB_MIGRATIONS_RUN=true
# DB_SYNCHRONIZE=false

API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-ngau-nhien
JWT_EXPIRES_IN=1d

# Admin đầu tiên (tuỳ chọn). Có cả hai biến thì API tự tạo tài khoản admin khi khởi động;
# admin vào /admin để tạo tài khoản nhân viên. Mật khẩu tối thiểu 8 ký tự. Production đặt trong Railway Variables.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=doi-thanh-mat-khau-manh
