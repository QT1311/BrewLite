{
  "name": "brewlite",
  "version": "0.1.0",
  "private": true,
  "description": "BrewLite - ứng dụng đặt đồ uống không dùng tiền mặt (Next.js + NestJS + PostgreSQL)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace apps/api",
    "test:ui": "playwright test -c tests/e2e/playwright.config.ts",
    "test:perf": "node tests/perf/api-latency.mjs"
  },
  "overrides": {
    "multer": "^2.5.0",
    "postcss": "^8.5.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "~15.5.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.72.1"
  }
}
